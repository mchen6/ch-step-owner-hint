{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/",
  "type": "object",
  "ownerService": {
    "hint": {
      "input": {
        "type": "object",
        "properties": {
          "firstSeen": {
            "title": "the commit where the failure first appeared",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{7,40}$"
                  },
                  "authorLogin": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}(?:\\[bot\\])?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "commit",
                  "authorLogin"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "stepCommits": {
            "title": "recent commits before the failure, most relevant first",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{7,40}$"
                },
                "authorLogin": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}(?:\\[bot\\])?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "commit",
                "authorLogin"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "firstSeen",
          "stepCommits"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "logins": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}(?:\\[bot\\])?$"
            }
          },
          "why": {
            "title": "one sentence per login, same order",
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "logins",
          "why"
        ],
        "additionalProperties": false
      }
    }
  },
  "fault": {
    "ownerService": {
      "hint": {
        "fault": {
          "type": "object",
          "properties": {
            "reason": {
              "title": "specific error reason",
              "type": "string"
            },
            "info": {
              "title": "detailed error info",
              "type": "string"
            }
          }
        }
      }
    }
  }
}
